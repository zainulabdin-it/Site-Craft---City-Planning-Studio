# Frontend: copy these VITE variables to apps/web/.env.local, then restart Vite.
# Optional; without credentials the app explicitly shows flat ellipsoid mode.
VITE_CESIUM_ION_TOKEN=
# Optional licensed XYZ imagery URL. Keep dataset attribution visible.
VITE_IMAGERY_URL=
VITE_IMAGERY_CREDIT=
# Optional replacement for the OpenStreetMap Nominatim search endpoint.
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# API: set in your PowerShell environment. Default is local SQLite fallback.
DATABASE_URL=postgresql+psycopg://planner:local-development-only@127.0.0.1:5432/planner
POSTGRES_PASSWORD=local-development-only
# S3-compatible storage adapter (not yet exposed as an upload API).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
